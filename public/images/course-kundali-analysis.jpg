<svg width="640" height="400" viewBox="0 0 640 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="640" height="400" fill="#3D291D"/>
  <!-- Kundali Chart Diagram -->
  <rect x="200" y="80" width="240" height="240" stroke="#B68A3A" stroke-width="1.2"/>
  <line x1="200" y1="80" x2="440" y2="320" stroke="#B68A3A" stroke-width="0.8"/>
  <line x1="440" y1="80" x2="200" y2="320" stroke="#B68A3A" stroke-width="0.8"/>
  <polygon points="320,80 440,200 320,320 200,200" stroke="#B68A3A" stroke-width="1" fill="#B68A3A" fill-opacity="0.08"/>
  <circle cx="320" cy="200" r="24" stroke="#B68A3A" stroke-width="0.8" fill="#1F1510"/>
  <text x="320" y="206" fill="#D4A85A" font-size="14" font-family="serif" text-anchor="middle">१</text>
  <!-- Title Badge -->
  <rect x="120" y="335" width="400" height="44" fill="#1F1510" stroke="#B68A3A" stroke-width="0.8"/>
  <text x="320" y="362" fill="#FFFDF8" font-size="14" font-family="serif" text-anchor="middle" letter-spacing="1">ADVANCED KUNDALI ANALYSIS</text>
</svg>
