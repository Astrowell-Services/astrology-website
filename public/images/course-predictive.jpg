<svg width="640" height="400" viewBox="0 0 640 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="640" height="400" fill="#261A14"/>
  <!-- Predictive Vedic Geometry / Sun Burst -->
  <circle cx="320" cy="190" r="110" stroke="#B68A3A" stroke-width="0.8"/>
  <circle cx="320" cy="190" r="70" stroke="#B68A3A" stroke-width="0.6" stroke-dasharray="2 3"/>
  <circle cx="320" cy="190" r="28" fill="#632D3D" stroke="#B68A3A" stroke-width="1"/>
  <text x="320" y="196" fill="#FFFDF8" font-size="18" font-family="serif" text-anchor="middle">☉</text>
  <!-- Radiating Cardinal Rays -->
  {Array.from({ length: 12 }).map((_, i) => {
    const angle = i * 30;
    const rad = (angle * Math.PI) / 180;
    const x1 = 320 + 28 * Math.cos(rad);
    const y1 = 190 + 28 * Math.sin(rad);
    const x2 = 320 + 110 * Math.cos(rad);
    const y2 = 190 + 110 * Math.sin(rad);
    return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#B68A3A" stroke-width="0.5" stroke-opacity="0.6" />`;
  }).join('')}
  <rect x="100" y="335" width="440" height="44" fill="#1F1510" stroke="#B68A3A" stroke-width="0.8"/>
  <text x="320" y="362" fill="#FFFDF8" font-size="14" font-family="serif" text-anchor="middle" letter-spacing="1">PREDICTIVE ASTROLOGY MASTERCLASS</text>
</svg>
