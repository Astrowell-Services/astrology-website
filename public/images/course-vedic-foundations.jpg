<svg width="640" height="400" viewBox="0 0 640 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="640" height="400" fill="#2E2018"/>
  <!-- Planetary Orbit Diagram -->
  <circle cx="320" cy="200" r="140" stroke="#B68A3A" stroke-width="0.8" stroke-opacity="0.6"/>
  <circle cx="320" cy="200" r="90" stroke="#B68A3A" stroke-width="0.5" stroke-dasharray="3 4" stroke-opacity="0.7"/>
  <circle cx="320" cy="200" r="40" stroke="#B68A3A" stroke-width="0.8" stroke-opacity="0.8"/>
  <circle cx="320" cy="200" r="8" fill="#D4A85A"/>
  <!-- Orbiting Planets -->
  <circle cx="410" cy="200" r="10" fill="#B68A3A"/>
  <circle cx="270" cy="90" r="7" fill="#FFFDF8"/>
  <circle cx="210" cy="270" r="12" fill="#632D3D" stroke="#B68A3A" stroke-width="1"/>
  <!-- Title Badge -->
  <rect x="120" y="320" width="400" height="48" fill="#1F1510" stroke="#B68A3A" stroke-width="0.8"/>
  <text x="320" y="350" fill="#FFFDF8" font-size="14" font-family="serif" text-anchor="middle" letter-spacing="1">VEDIC ASTROLOGY FOUNDATIONS</text>
</svg>
